{
  "name": "inventory-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "dev": "next dev --turbopack",
    "dev:clean": "npm run clean && next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "clean": "rimraf .next .turbo node_modules/.cache",
    "clean:all": "rimraf .next .turbo node_modules/.cache node_modules && npm install",
    "import:tools": "node scripts/import-tools.js",
    "cleanup:notifications": "ts-node scripts/cleanup-test-notifications.ts",
    "type-check": "tsc --noEmit",
    "analyze": "node scripts/analyze-bundle.js",
    "build:analyze": "npm run build && npm run analyze",
    "verify-env": "node scripts/verify-env.js",
    "verify-images": "node scripts/verify-images.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@reduxjs/toolkit": "^2.9.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "framer-motion": "^12.23.22",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lightningcss": "^1.30.2",
    "lucide-react": "^0.544.0",
    "next": "^15.5.7",
    "next-pwa": "^5.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.63.0",
    "react-redux": "^9.2.0",
    "recharts": "^2.15.0",
    "sharp": "^0.33.5",
    "sonner": "^2.0.7",
    "uuid": "^11.0.5",
    "xlsx": "^0.18.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "fast-check": "^4.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "workbox-webpack-plugin": "^7.3.0"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  }
}
